# ─────────────────────────────────────────────────────────────
# Capybara backend configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit your real .env — it is gitignored.
# ─────────────────────────────────────────────────────────────

# --- Alpaca (PAPER trading) -----------------------------------
# Create paper keys at https://app.alpaca.markets (switch to "Paper" account).
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
# Keep this True. Live trading is intentionally out of scope for now.
ALPACA_PAPER=True

# --- Trading universe -----------------------------------------
# Comma-separated symbols the bot is allowed to trade (US equities + ETFs).
CAPYBARA_UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,IWM

# --- Autonomy -------------------------------------------------
# 0 = approval mode (every order queues for human approval)
# 1 = auto within limits (unusual/oversized orders queue)   <-- default
# 2 = full auto within guardrails
CAPYBARA_AUTONOMY_LEVEL=1

# How often the decision loop runs while the market is open (seconds).
# Swing trading does not need a fast loop; 300s (5 min) is plenty.
CAPYBARA_LOOP_INTERVAL_SECONDS=300

# --- Risk guardrails (L1) -------------------------------------
CAPYBARA_MAX_DAILY_LOSS_PCT=3.0        # halt for the day if equity down this % from day start
CAPYBARA_MAX_DRAWDOWN_PCT=15.0         # halt if down this % from peak equity
CAPYBARA_MAX_POSITION_PCT=20.0         # max % of equity in any single symbol
CAPYBARA_MAX_CONCURRENT_POSITIONS=5    # max number of open positions
CAPYBARA_MAX_GROSS_EXPOSURE_PCT=100.0  # max total invested % of equity (no leverage by default)
CAPYBARA_MAX_ORDERS_PER_MIN=10         # rate limit safety valve
CAPYBARA_APPROVAL_ORDER_NOTIONAL=5000  # orders above this $ notional queue for approval (L1)

# --- Risk hardening (Phase 2) ---------------------------------
CAPYBARA_ENABLE_VOL_TARGETING=True     # size positions inversely to volatility
CAPYBARA_TARGET_VOL=0.15               # annualized target vol per position (15%)
CAPYBARA_MAX_SECTOR_PCT=40.0           # max % of equity in any one sector
CAPYBARA_ENABLE_CORRELATION_CONTROL=True  # trim highly-correlated concurrent longs
CAPYBARA_ENABLE_BRACKET_ORDERS=True    # attach stop-loss/take-profit brackets to entries

# --- Selector (Phase 2) ---------------------------------------
# "rules" = interpretable regime->strategy table; "bandit" = learned LinUCB model.
CAPYBARA_SELECTOR=rules
CAPYBARA_BANDIT_MODEL_PATH=./bandit_model.npz
# Optional: path to a learned Stage-1 score table (JSON) from `capybara attribution`.
CAPYBARA_SCORES_PATH=

# --- Sentiment & horizon (Phase 3) ----------------------------
CAPYBARA_ENABLE_SENTIMENT=True         # read news sentiment (Alpaca) and act on it
CAPYBARA_SENTIMENT_NEG_VETO=-0.5       # veto NEW long entries at/below this sentiment
CAPYBARA_SENTIMENT_TILT_K=0.4          # position-size tilt strength from sentiment
CAPYBARA_SENTIMENT_LOOKBACK_HOURS=48   # news window per symbol
CAPYBARA_ENABLE_AUTO_HORIZON=True      # bot decides day-trade vs swing per opportunity
# Data path / clock: 1Day (swing, default) or 1Hour/15Min/5Min/1Min (intraday).
CAPYBARA_TIMEFRAME=1Day

# --- Notifications (Phase 4) ----------------------------------
# Get pushed alerts (halts, approvals, kill switch) + a plain-English daily digest,
# so you don't have to keep checking the dashboard.
CAPYBARA_ENABLE_NOTIFICATIONS=False
CAPYBARA_NOTIFY_MIN_LEVEL=warning       # info | warning | critical
CAPYBARA_NOTIFY_DEDUP_SECONDS=300
CAPYBARA_DAILY_DIGEST=True
# Slack/Discord/generic incoming webhook URL (format auto-detected):
CAPYBARA_NOTIFY_WEBHOOK_URL=
# Email via SMTP (optional):
CAPYBARA_NOTIFY_EMAIL_TO=
CAPYBARA_SMTP_HOST=
CAPYBARA_SMTP_PORT=587
CAPYBARA_SMTP_USER=
CAPYBARA_SMTP_PASSWORD=
CAPYBARA_SMTP_FROM=

# --- Persistence ----------------------------------------------
# SQLite by default (zero-config). Point at Postgres later if desired.
CAPYBARA_DB_PATH=./capybara.db

# --- Control-plane API ----------------------------------------
CAPYBARA_API_HOST=0.0.0.0
CAPYBARA_API_PORT=8000
# Comma-separated allowed origins for the dashboard (CORS).
CAPYBARA_CORS_ORIGINS=http://localhost:3000
# Shared secret the dashboard must send as `x-api-key` to issue commands.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CAPYBARA_API_TOKEN=change_me_to_a_long_random_string
